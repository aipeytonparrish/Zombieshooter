# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
# *.obj  (removed: OBJ meshes are tracked by LFS; compiled objects live in Intermediate/)

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# ---- Zombieshooter additions ----
# IDE / editor files
.idea/
.vscode/
*.code-workspace
*.uproject.user
compile_commands.json

# Engine-generated per-machine folders (also inside nested plugins)
Platforms/*/Binaries/*
Platforms/*/Intermediate/*
**/Saved/*
**/Intermediate/*
**/DerivedDataCache/*

# Packaged builds
Packaged/
ArchivedBuilds/

# Per-user content folders and recovery files
Content/Developers/
Content/Collections/
*.uasset.bak
*.umap.bak

# OS clutter
Thumbs.db
.DS_Store

# ---- Third-party purchased packs: NOT versioned (license + size). See Docs/ThirdPartyAssets.md to restore. ----
/SourceArt/ThirdParty/
/Content/MS_NewYorkCityKitbash_Assets/
/Content/RoadPack01/
/Content/ZombieCity01/
/Content/ZombieDoctor/
/Content/Zombie_Animation_Pack_Vol01/
/Content/Zombie_Anim/
/Content/Zombie_deaths_crawls/
/Content/Zombie_attack_hit_reaction_anim/
/Content/AAA_FPS_Gloves/
/Content/AAA_FPS_Gloves_Vol2/
/Content/__ExternalActors__/AAA_FPS_Gloves_Vol2/
/Content/__ExternalObjects__/AAA_FPS_Gloves_Vol2/
/Content/SurvivorsMegaPack/
